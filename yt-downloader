def detect_playlist(url: str) -> bool:
    """Check if a URL points to a playlist (YouTube or other sites)."""
    playlist_patterns = [
        r"[?&]list=",                        # YouTube playlist param
        r"/playlist\?",                      # YouTube playlist URL
        r"/sets/",                           # SoundCloud sets
        r"/album/",                          # Bandcamp / Spotify albums
        r"udemy\.com/course/",               # Udemy courses
        r"skillshare\.com/classes/",         # Skillshare courses
        r"coursera\.org/.*/",                # Coursera courses
    ]
    for pattern in playlist_patterns:
        if re.search(pattern, url, re.IGNORECASE):
            return True
    return False

def get_playlist_info(url: str):
    """Fetch playlist metadata: title, uploader, and list of video entries."""
    print(f"\n{Colors.YELLOW}⏳ Fetching playlist information... This may take a moment.{Colors.RESET}")
    cmd = [
        "yt-dlp",
        "--no-warnings",
        "--flat-playlist",
        "--dump-single-json",
        url
    ]
    try:
        proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=True)
        data = json.loads(proc.stdout)

        playlist_title = data.get("title", "Unknown Playlist")
        uploader = data.get("uploader") or data.get("channel") or "Unknown"
        entries = data.get("entries", [])

        # Build a compact list of videos with index, title, and duration
        videos = []
        for i, entry in enumerate(entries, start=1):
            v_title = entry.get("title") or entry.get("id") or f"Video {i}"
            v_duration = entry.get("duration")
            if v_duration is not None:
                mins, secs = divmod(int(v_duration), 60)
                hrs, mins = divmod(mins, 60)
                dur_str = f"{hrs}:{mins:02d}:{secs:02d}" if hrs else f"{mins}:{secs:02d}"
            else:
                dur_str = "N/A"
            videos.append({"index": i, "title": v_title, "duration": dur_str})

        return {
            "valid": True,
            "title": playlist_title,
            "uploader": uploader,
            "count": len(videos),
            "videos": videos,
        }
    except subprocess.CalledProcessError as e:
        err_msg = e.stderr.strip() if e.stderr else str(e)
        return {"valid": False, "error": err_msg}
    except json.JSONDecodeError as e:
        return {"valid": False, "error": f"Failed to parse playlist data: {e}"}
    except Exception as e:
        return {"valid": False, "error": str(e)}

def display_playlist_info(info: dict):
    """Display playlist metadata and video listing."""
    print(f"\n{Colors.GREEN}{Colors.BOLD}📋 Playlist / Course Detected!{Colors.RESET}")
    print(f"  {Colors.BOLD}📌 Title:{Colors.RESET}    {info['title']}")
    print(f"  {Colors.BOLD}👤 Uploader:{Colors.RESET} {info['uploader']}")
    print(f"  {Colors.BOLD}🎞️  Videos:{Colors.RESET}   {info['count']} items")

    # Show first 15 videos as preview, plus a summary if more exist
    preview_limit = 15
    print(f"\n{Colors.CYAN}{Colors.BOLD}─── Video Listing ───{Colors.RESET}")
    for v in info["videos"][:preview_limit]:
        idx_str = f"{v['index']:>3}"
        print(f"  {Colors.GREEN}{idx_str}.{Colors.RESET} {v['title']}  {Colors.DIM}[{v['duration']}]{Colors.RESET}")
    if info["count"] > preview_limit:
        remaining = info["count"] - preview_limit
        print(f"  {Colors.DIM}... and {remaining} more video(s){Colors.RESET}")

def prompt_playlist_range(total: int):
    """Ask the user which videos from the playlist to download."""
    print(f"\n{Colors.CYAN}{Colors.BOLD}─── Playlist Download Range ───{Colors.RESET}")
    print(f" {Colors.GREEN}[1]{Colors.RESET} 📥 Download ALL {total} videos {Colors.DIM}[Default]{Colors.RESET}")
    print(f" {Colors.GREEN}[2]{Colors.RESET} 🔢 Download a range (e.g. videos 3 to 10)")
    print(f" {Colors.GREEN}[3]{Colors.RESET} 🎯 Download specific videos (e.g. 1,3,5,8)")
    print(f" {Colors.GREEN}[4]{Colors.RESET} ⏭️  Start from a specific video (resume)")

    while True:
        choice = input(f"\n{Colors.BOLD}Select option [1-4] (Default: 1): {Colors.RESET}").strip()

        if choice in ("", "1"):
            return {"mode": "all"}

        elif choice == "2":
            while True:
                range_input = input(f"{Colors.BOLD}Enter range (start-end, e.g. 3-10): {Colors.RESET}").strip()
                match = re.match(r"^(\d+)\s*[-–]\s*(\d+)$", range_input)
                if match:
                    start, end = int(match.group(1)), int(match.group(2))
                    if 1 <= start <= end <= total:
                        print(f"{Colors.GREEN}✓ Will download videos {start} to {end} ({end - start + 1} videos){Colors.RESET}")
                        return {"mode": "range", "start": start, "end": end}
                    else:
                        print(f"{Colors.RED}Range must be between 1 and {total}, and start ≤ end.{Colors.RESET}")
                else:
                    print(f"{Colors.RED}Invalid format. Use: start-end (e.g. 3-10){Colors.RESET}")

        elif choice == "3":
            while True:
                items_input = input(f"{Colors.BOLD}Enter video numbers (comma-separated, e.g. 1,3,5,8): {Colors.RESET}").strip()
                try:
                    items = [int(x.strip()) for x in items_input.split(",") if x.strip()]
                    if all(1 <= x <= total for x in items) and len(items) > 0:
                        items = sorted(set(items))
                        print(f"{Colors.GREEN}✓ Will download {len(items)} specific video(s): {', '.join(map(str, items))}{Colors.RESET}")
                        return {"mode": "items", "items": items}
                    else:
                        print(f"{Colors.RED}All numbers must be between 1 and {total}.{Colors.RESET}")
                except ValueError:
                    print(f"{Colors.RED}Invalid input. Enter comma-separated numbers (e.g. 1,3,5,8){Colors.RESET}")

        elif choice == "4":
            while True:
                start_input = input(f"{Colors.BOLD}Start from video number (1-{total}): {Colors.RESET}").strip()
                try:
                    start = int(start_input)
                    if 1 <= start <= total:
                        remaining = total - start + 1
                        print(f"{Colors.GREEN}✓ Will download from video {start} to {total} ({remaining} videos){Colors.RESET}")
                        return {"mode": "range", "start": start, "end": total}
                    else:
                        print(f"{Colors.RED}Number must be between 1 and {total}.{Colors.RESET}")
                except ValueError:
                    print(f"{Colors.RED}Invalid number.{Colors.RESET}")

        else:
            print(f"{Colors.RED}Invalid selection. Please enter a number between 1 and 4.{Colors.RESET}")

