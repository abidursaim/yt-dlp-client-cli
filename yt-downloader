def run_download():
    """Main execution loop."""
    print_banner()
    check_dependencies()
    
    default_dir = os.getcwd()

    while True:
        try:
            print(f"\n{Colors.BOLD}{Colors.MAGENTA}══════════════════════════════════════════════════════════════════{Colors.RESET}")
            url = input(f"{Colors.BOLD}{Colors.CYAN}🔗 Enter video/playlist URL (or 'q' to exit): {Colors.RESET}").strip()
            
            if not url:
                print(f"{Colors.RED}[!] URL cannot be empty.{Colors.RESET}")
                continue
            if url.lower() in ("q", "quit", "exit"):
                print(f"\n{Colors.GREEN}Thanks for using YT-DLP Downloader. Goodbye! 👋{Colors.RESET}\n")
                break

            # ── Detect playlist vs single video ──
            is_playlist = detect_playlist(url)

            if is_playlist:
                # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
                #        PLAYLIST / COURSE MODE
                # ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

                # Offer choice: some URLs could be both video+playlist
                print(f"\n{Colors.YELLOW}{Colors.BOLD}🎵 Playlist / Course URL detected!{Colors.RESET}")
                print(f" {Colors.GREEN}[1]{Colors.RESET} 📋 Download entire playlist / course {Colors.DIM}[Default]{Colors.RESET}")
                print(f" {Colors.GREEN}[2]{Colors.RESET} 🎬 Download only the single video from this URL")
                mode_choice = input(f"\n{Colors.BOLD}Select mode [1-2] (Default: 1): {Colors.RESET}").strip()

                if mode_choice == "2":
                    is_playlist = False  # Fall through to single-video flow below

            if is_playlist:
                # Fetch playlist info
                pl_info = get_playlist_info(url)
                if not pl_info["valid"]:
                    print(f"{Colors.RED}[✘] Could not retrieve playlist information.{Colors.RESET}")
                    print(f"{Colors.YELLOW}Error detail:{Colors.RESET} {pl_info.get('error', 'Unknown error')}")
                    continue

                if pl_info["count"] == 0:
                    print(f"{Colors.RED}[✘] Playlist appears to be empty.{Colors.RESET}")
                    continue

                # Display playlist details
                display_playlist_info(pl_info)

                # Step 1: Video Quality
                v_quality = prompt_video_quality()
                is_audio_only = (v_quality == "audio_only")

                # Step 2: Audio Quality
                a_quality = prompt_audio_quality(is_audio_only)

                # Step 3: Download Range
                range_info = prompt_playlist_range(pl_info["count"])

                # Step 4: File Naming
                naming_pattern = prompt_playlist_naming()

                # Step 5: Save Location
