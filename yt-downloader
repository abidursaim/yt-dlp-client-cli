def build_playlist_command(url: str, v_quality: str, a_quality: dict,
                           naming_pattern: str, output_dir: str,
                           range_info: dict, use_archive: bool):
    """Construct the yt-dlp command for playlist/course downloads."""
    cmd = ["yt-dlp", "--no-warnings", "--yes-playlist"]

    # Output filename template with zero-padded index
    out_template = os.path.join(output_dir, f"{naming_pattern}.%(ext)s")
    cmd.extend(["-o", out_template])

    # Playlist range filtering
    if range_info["mode"] == "range":
        cmd.extend(["--playlist-start", str(range_info["start"]),
                     "--playlist-end", str(range_info["end"])])
    elif range_info["mode"] == "items":
        items_str = ",".join(str(i) for i in range_info["items"])
        cmd.extend(["--playlist-items", items_str])
    # "all" mode: no extra flags needed

    # Download archive for resume support
    if use_archive:
        archive_path = os.path.join(output_dir, ".ytdl-archive.txt")
        cmd.extend(["--download-archive", archive_path])

    # Quality settings (same logic as single-video)
    if v_quality == "audio_only":
        cmd.append("-x")
        if a_quality["type"] == "mp3":
            cmd.extend(["--audio-format", "mp3", "--audio-quality", a_quality["quality"]])
        else:
            cmd.extend(["--audio-format", "best", "--audio-quality", "0"])
    else:
        if v_quality == "best":
            cmd.extend(["-f", "bv*+ba/b"])
        else:
            cmd.extend(["-f", f"bv*[height<={v_quality}]+ba/b[height<={v_quality}]/best"])
        cmd.extend(["--merge-output-format", "mp4"])
        if a_quality["type"] == "encode":
            cmd.extend(["--postprocessor-args", f"Merger:-c:a aac -b:a {a_quality['quality']}"])

    # Throttle to be polite & avoid rate limits
    cmd.extend(["--sleep-interval", "1", "--max-sleep-interval", "3"])

    cmd.append(url)
    return cmd

