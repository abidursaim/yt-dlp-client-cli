    """Prompt user to select video quality."""
    print(f"\n{Colors.CYAN}{Colors.BOLD}─── [1/4] Select Video Quality ───{Colors.RESET}")
    print(f" {Colors.GREEN}[1]{Colors.RESET} 🌟 Best Quality Available (4K / 2K / 1080p / Max) {Colors.DIM}[Default]{Colors.RESET}")
    print(f" {Colors.GREEN}[2]{Colors.RESET} 📺 1080p (Full HD)")
    print(f" {Colors.GREEN}[3]{Colors.RESET} 📺 720p (HD)")
    print(f" {Colors.GREEN}[4]{Colors.RESET} 📺 480p (SD)")
    print(f" {Colors.GREEN}[5]{Colors.RESET} 📺 360p (Low)")
    print(f" {Colors.GREEN}[6]{Colors.RESET} 🎵 Audio Only (Extract MP3 / Best Audio)")

    while True:
        choice = input(f"\n{Colors.BOLD}Select video quality [1-6] (Default: 1): {Colors.RESET}").strip()
        if choice in ("", "1"):
            return "best"
        elif choice == "2":
            return "1080"
        elif choice == "3":
            return "720"
        elif choice == "4":
            return "480"
        elif choice == "5":
            return "360"
        elif choice == "6":
            return "audio_only"
        else:
            print(f"{Colors.RED}Invalid selection. Please enter a number between 1 and 6.{Colors.RESET}")

