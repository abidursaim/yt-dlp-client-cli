#!/usr/bin/env python3
"""
====================================================================
                    YT-DLP INTERACTIVE DOWNLOADER
====================================================================
A sleek, interactive CLI program to download videos and audio 
using yt-dlp on Kali Linux.
====================================================================
"""

import sys
import os
import shutil
import subprocess
import re
from pathlib import Path

# --- ANSI Color Codes for Kali Linux Terminal ---
class Colors:
    CYAN = "\033[96m"
    BLUE = "\033[94m"
    GREEN = "\033[92m"
    YELLOW = "\033[93m"
    RED = "\033[91m"
    MAGENTA = "\033[95m"
    BOLD = "\033[1m"
    DIM = "\033[2m"
    RESET = "\033[0m"

def print_banner():
    banner = f"""{Colors.CYAN}{Colors.BOLD}
╔══════════════════════════════════════════════════════════════════╗
║               🎬  YT-DLP MEDIA DOWNLOADER  🚀                   ║
║                     Interactive Kali CLI                         ║
╚══════════════════════════════════════════════════════════════════╝{Colors.RESET}"""
    print(banner)

def sanitize_filename(filename: str) -> str:
    """Remove illegal filesystem characters from custom name."""
    sanitized = re.sub(r'[\\/*?:"<>|]', "", filename).strip()
    return sanitized if sanitized else "download"

def check_dependencies():
    """Verify yt-dlp and ffmpeg are installed."""
    missing = []
    if not shutil.which("yt-dlp"):
        missing.append("yt-dlp")
    if not shutil.which("ffmpeg"):
        missing.append("ffmpeg")
    
    if missing:
        print(f"{Colors.RED}[!] Missing required tool(s): {', '.join(missing)}{Colors.RESET}")
        print(f"{Colors.YELLOW}Please install them before running this program:{Colors.RESET}")
        if "yt-dlp" in missing:
            print("  sudo apt update && sudo apt install yt-dlp")
        if "ffmpeg" in missing:
            print("  sudo apt install ffmpeg")
        sys.exit(1)

def get_video_info(url: str):
    """Fetch video title, channel, and duration using yt-dlp."""
    print(f"\n{Colors.YELLOW}⏳ Fetching video information... Please wait.{Colors.RESET}")
    cmd = [
        "yt-dlp",
        "--no-warnings",
        "--print", "%(title)s|||%(uploader)s|||%(duration_string)s",
        "--no-playlist",
        url
    ]
    try:
        proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=True)
        out = proc.stdout.strip()
        parts = out.split("|||")
        title = parts[0].strip() if len(parts) > 0 else "Unknown Title"
        uploader = parts[1].strip() if len(parts) > 1 and parts[1].strip() else "Unknown Channel"
        duration = parts[2].strip() if len(parts) > 2 and parts[2].strip() else "N/A"
        return {"title": title, "uploader": uploader, "duration": duration, "valid": True}
    except subprocess.CalledProcessError as e:
        err_msg = e.stderr.strip() if e.stderr else str(e)
        return {"valid": False, "error": err_msg}
    except Exception as e:
        return {"valid": False, "error": str(e)}

